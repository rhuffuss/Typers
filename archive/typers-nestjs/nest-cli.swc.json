{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src/tooling-lab/swc-only",
  "entryFile": "main",
  "compilerOptions": {
    "builder": { "type": "swc", "options": { "swcrcPath": ".swcrc" } },
    "tsConfigPath": "tsconfig.swc.json",
    "typeCheck": true,
    "deleteOutDir": true
  }
}
