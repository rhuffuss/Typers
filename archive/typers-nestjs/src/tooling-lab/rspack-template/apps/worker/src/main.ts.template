import 'reflect-metadata';
import { Module } from '@nestjs/common';
import { NestFactory } from '@nestjs/core';
import { SharedBuildModule, SharedBuildService } from '@tooling/shared';

@Module({ imports: [SharedBuildModule] })
class RspackWorkerModule {}
const app = await NestFactory.createApplicationContext(RspackWorkerModule, {
  logger: false,
});
try {
  console.log(
    JSON.stringify({
      kind: 'rspack-worker',
      message: app.get(SharedBuildService).read(),
    }),
  );
} finally {
  await app.close();
}
