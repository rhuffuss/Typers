{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main",
  "compilerOptions": {
    "builder": {
      "type": "webpack",
      "options": { "configPath": "webpack.hmr.cjs" }
    },
    "tsConfigPath": "tsconfig.hmr.json",
    "deleteOutDir": false
  }
}
