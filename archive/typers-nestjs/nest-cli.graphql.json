{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src/graphql-lab/plugin-fixture",
  "entryFile": "main",
  "compilerOptions": {
    "builder": "tsc",
    "tsConfigPath": "tsconfig.graphql.json",
    "deleteOutDir": true,
    "plugins": [
      {
        "name": "@nestjs/graphql",
        "options": {
          "typeFileNameSuffix": [".model.ts"],
          "introspectComments": true
        }
      }
    ]
  }
}
