{
  "name": "typers-nestjs",
  "version": "0.0.1",
  "description": "Executable NestJS documentation and compiler compatibility laboratory for Typers",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "pnpm generate:prisma && nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,ts,yaml}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --enable-source-maps dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "generate:prisma": "prisma generate --config src/persistence-labs/prisma/prisma.config.ts",
    "build:swagger": "nest build --config nest-cli.swagger.json",
    "build:graphql": "nest build --config nest-cli.graphql.json",
    "build:swc": "nest build --config nest-cli.swc.json",
    "build:rspack": "node src/tooling-lab/prepare-workspace.ts --build",
    "start:fastify": "node --env-file-if-exists=.env dist/platform/main.fastify.js",
    "start:graphql:schema": "node --env-file-if-exists=.env dist/graphql-lab/main.schema-first.js",
    "start:graphql:federation": "node --env-file-if-exists=.env dist/graphql-lab/main.federation.js",
    "standalone": "node --env-file-if-exists=.env dist/standalone/main.js",
    "commander": "node --env-file-if-exists=.env dist/standalone/main.commander.js",
    "repl": "node --env-file-if-exists=.env dist/standalone/main.repl.js",
    "migration:run": "node --env-file-if-exists=.env node_modules/typeorm/cli.js migration:run -d dist/workspaces/persistence/data-source.js",
    "migration:revert": "node --env-file-if-exists=.env node_modules/typeorm/cli.js migration:revert -d dist/workspaces/persistence/data-source.js",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.{json,ts,yaml}\"",
    "test:integration": "node scripts/run-integration.mjs",
    "test:emitted": "node scripts/check-emitted.mjs",
    "compiler:report": "node scripts/compiler-report.mjs",
    "check": "pnpm generate:prisma && pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e && pnpm build && pnpm test:emitted && pnpm test:business:emitted && pnpm test:advanced:emitted && pnpm coverage:check && pnpm api:check",
    "infra:up": "docker compose --profile all up -d --wait",
    "infra:down": "docker compose --profile all down",
    "start:swc": "nest start --config nest-cli.swc.json",
    "start:tls": "node --env-file-if-exists=.env dist/deployment-lab/main.tls.js",
    "build:observe": "tsc -p src/observability/tsconfig.lab.json",
    "start:observe": "node --env-file-if-exists=.env dist-observe/main.observe.js",
    "start:devtools": "node --env-file-if-exists=.env dist-observe/main.devtools.js",
    "coverage:check": "node scripts/check-coverage.mjs",
    "hmr:prepare": "node src/tooling-lab/hmr/prepare-workspace.ts",
    "typecheck:business": "tsc -p tsconfig.business.json --noEmit",
    "test:business": "vitest run src/business",
    "test:business:emitted": "node scripts/check-business-emitted.mjs",
    "start:operations": "node dist/operations-lab/main.operations.js",
    "start:di": "node dist/fundamentals-advanced/main.di.js",
    "language:prepare": "node src/language-lab/prepare-workspace.ts",
    "test:language": "vitest run --config vitest.config.e2e.ts test/language-lab.e2e-spec.ts",
    "test:advanced:emitted": "node scripts/check-advanced-emitted.mjs",
    "api:inventory": "node scripts/nest-api-inventory.mjs",
    "api:check": "node scripts/nest-api-inventory.mjs --self-test && node scripts/nest-api-inventory.mjs --check",
    "compare:typers": "node scripts/compare-typers.mjs",
    "demo:typers": "node scripts/demonstrate-typers.mjs",
    "start:typers": "node scripts/typers-app.mjs start",
    "build:typers": "node scripts/typers-app.mjs build",
    "test:typers": "node scripts/typers-app.mjs test",
    "typecheck:typers": "node scripts/typers-app.mjs typecheck",
    "typers:refresh": "node scripts/typers-app.mjs refresh"
  },
