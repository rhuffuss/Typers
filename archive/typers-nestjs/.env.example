NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=http://localhost:3000
# This configured profile uses PostgreSQL; omit .env for the in-memory demo.
DEMO_DATABASE=postgres
DATABASE_URL=postgresql://typers:typers-demo-local@127.0.0.1:55432/typers
# Set explicit secrets for deployments. Local defaults generate secrets per process.
# JWT_SECRET=
# SESSION_SECRET=
# DEMO_ADMIN_PASSWORD=
# DEMO_READER_PASSWORD=
# DEMO_UPSTREAM_URL=http://127.0.0.1:4000
# Observe is a separate opt-in entry point. Never commit real credentials.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
# Extra business identities have defaults in development/test.
# In production each is enabled only when its password is explicitly configured.
# DEMO_MEMBER_PASSWORD=
# DEMO_APPROVER_PASSWORD=
# DEMO_FINANCE_PASSWORD=
